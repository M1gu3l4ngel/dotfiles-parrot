// Installed as /etc/apt/apt.conf.d/20auto-upgrades. Turns on unattended-upgrades' daily run
// (systemd's apt-daily.timer and apt-daily-upgrade.timer); without it, 52parrot-hardening.conf
// exists but never runs. `dpkg-reconfigure unattended-upgrades` usually writes it; setup.sh
// installs it only if missing, so that manual step is not needed.
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
