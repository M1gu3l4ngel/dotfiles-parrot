# Installed as /etc/sudoers.d/anon_toggle. Lets the anonymity toggle (Super+A) run only these exact
# commands as root without a password. With the arguments listed, sudo refuses any other variant
# (`anonsurf changeid` or `anon-harden --anything` ask for a password or fail).
#
# Never NOPASSWD on iptables or ip6tables themselves: `--modprobe=<prog>` runs any program as root.
# That is why the kill switch rules live in /usr/local/sbin/anon-harden, which takes only up|down.
#
# __USER__ is a placeholder that 70-system/setup.sh replaces with $SUDO_USER on install, so the user
# name is not published in the repo.
__USER__ ALL=(root) NOPASSWD: /usr/bin/anonsurf start, /usr/bin/anonsurf stop, /usr/local/sbin/anon-harden up, /usr/local/sbin/anon-harden down
