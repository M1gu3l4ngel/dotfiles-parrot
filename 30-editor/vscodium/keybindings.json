// VSCodium's shortcuts, the same as VS Code on Windows (dotfiles-windows). install.sh links this
// file; changes apply on save.
[
  // Block comment with the numeric keypad's Ctrl + "/".
  {
    "key": "ctrl+numpad_divide",
    "command": "editor.action.blockComment",
    "when": "editorTextFocus && !editorReadonly"
  },
  // The default shortcut (Shift+Alt+A) goes, so the one above is the only one and does not clash
  // with other uses of that combination.
  {
    "key": "shift+alt+a",
    "command": "-editor.action.blockComment",
    "when": "editorTextFocus && !editorReadonly"
  },
  // Integrated terminal: Ctrl+Shift+Left/Right select word by word, as in kitty. VSCodium kept
  // those keys and they never reached zsh; this sends kitty's own sequence (xterm format), which
  // zsh already understands (Shift selection in .zshrc). Only with the terminal focused.
  {
    "key": "ctrl+shift+left",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;6D" },
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+shift+right",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;6C" },
    "when": "terminalFocus"
  }
]
