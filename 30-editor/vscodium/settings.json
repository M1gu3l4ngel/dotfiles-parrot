// VSCodium's settings (Parrot's build reads them from ~/.config/Visual Studio Code/User/). Based on
// VS Code's settings on Windows, adapted to Linux (zsh, CaskaydiaCove) and without what is Windows
// only (PowerShell, C:\ paths). Code reads with the Monokai theme; the interface uses the desktop
// palette (Monokai Soda) to match polybar, rofi and Nautilus. install.sh links this file; changes
// apply on save.
{
  "workbench.colorTheme": "Monokai",
  "workbench.iconTheme": "symbols",
  "workbench.productIconTheme": "fluent-icons",
  "workbench.startupEditor": "none",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.editor.tabSizing": "fixed",
  "workbench.editor.tabSizingFixedMaxWidth": 150,

  // Only the interface (backgrounds, borders, focus) takes the system palette; code colors stay
  // Monokai's. Scoped to "[Monokai]" so another theme does not inherit these backgrounds.
  "workbench.colorCustomizations": {
    "[Monokai]": {
      // Surfaces: the same background as the bars and Nautilus.
      "editor.background": "#1A1A1A",
      "editorGutter.background": "#1A1A1A",
      "sideBar.background": "#1A1A1A",
      "sideBarSectionHeader.background": "#1A1A1A",
      "activityBar.background": "#1A1A1A",
      "titleBar.activeBackground": "#1A1A1A",
      "titleBar.inactiveBackground": "#1A1A1A",
      "statusBar.background": "#1A1A1A",
      "statusBar.noFolderBackground": "#1A1A1A",
      "statusBar.debuggingBackground": "#1A1A1A",
      "editorGroupHeader.tabsBackground": "#1A1A1A",
      "tab.activeBackground": "#1A1A1A",
      "tab.inactiveBackground": "#1A1A1A",
      "panel.background": "#1A1A1A",
      "terminal.background": "#1A1A1A",
      "breadcrumb.background": "#1A1A1A",
      // Floating items and inputs, one step lighter.
      "editorWidget.background": "#242424",
      "quickInput.background": "#242424",
      "input.background": "#242424",
      "dropdown.background": "#242424",
      "menu.background": "#242424",
      "notifications.background": "#242424",
      "editorHoverWidget.background": "#242424",
      "editorSuggestWidget.background": "#242424",
      // Current line and list selection: subtle, not competing with the code.
      "editor.lineHighlightBackground": "#242424",
      "editor.lineHighlightBorder": "#00000000",
      "list.activeSelectionBackground": "#242424",
      "list.inactiveSelectionBackground": "#242424",
      "list.hoverBackground": "#242424",
      // Borders: the same neutral grey as the windows and bars.
      "sideBar.border": "#343434",
      "activityBar.border": "#343434",
      "titleBar.border": "#343434",
      "statusBar.border": "#343434",
      "panel.border": "#343434",
      "editorGroup.border": "#343434",
      "tab.border": "#1A1A1A",
      // Interface text: warm grey, dimmed when inactive.
      "foreground": "#C4C5B5",
      "statusBar.foreground": "#C4C5B5",
      "titleBar.activeForeground": "#C4C5B5",
      "titleBar.inactiveForeground": "#8F8B7A",
      "activityBar.foreground": "#C4C5B5",
      "activityBar.inactiveForeground": "#8F8B7A",
      "tab.activeForeground": "#C4C5B5",
      "tab.inactiveForeground": "#8F8B7A",
      "editorLineNumber.foreground": "#625E4C",
      "editorLineNumber.activeForeground": "#C4C5B5",
      // Explorer: the same colors as Monokai Night on Windows (Monokai defines no git colors and
      // fell back to duller generic ones). Unchanged files in near white, apart from the ignored
      // ones (dark grey).
      "sideBar.foreground": "#DDDDDD",
      "gitDecoration.modifiedResourceForeground": "#B3B42B",
      "gitDecoration.untrackedResourceForeground": "#86B42B",
      "gitDecoration.addedResourceForeground": "#007ACC",
      "gitDecoration.deletedResourceForeground": "#C4265E",
      "gitDecoration.conflictingResourceForeground": "#FE413F",
      "gitDecoration.ignoredResourceForeground": "#777777",
      "gitDecoration.submoduleResourceForeground": "#2BB3B4",
      // Focus and active items: the neutral grey of bspwm's focused window border. Clear without
      // distracting; strong colors stay for the code. Light text (#F6F6EF) on top of the grey.
      "focusBorder": "#555555",
      "tab.activeBorderTop": "#555555",
      "tab.activeBorder": "#1A1A1A",
      "activityBar.activeBorder": "#555555",
      "activityBarBadge.background": "#555555",
      "activityBarBadge.foreground": "#F6F6EF",
      "badge.background": "#555555",
      "badge.foreground": "#F6F6EF",
      "button.background": "#555555",
      "button.foreground": "#F6F6EF",
      "button.hoverBackground": "#625E4C",
      "progressBar.background": "#555555"
    }
  },
  "editor.tokenColorCustomizations": {
    "comments": "#9a9c9a"
  },

  "editor.fontFamily": "'CaskaydiaCove Nerd Font', monospace",
  // SemiBold: Linux draws a thinner stroke than Windows (ClearType) at the same weight, and the
  // family has no Medium (a 500 would fall back to Regular). The same weight as polybar's text.
  "editor.fontWeight": "600",
  "editor.fontLigatures": true,
  "editor.wordWrap": "off",
  "editor.codeLens": true,
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.linkedEditing": true,
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.scrollbar.verticalScrollbarSize": 8,
  "editor.scrollbar.horizontalScrollbarSize": 5,
  "editor.detectIndentation": false,
  "editor.tabSize": 2,
  "editor.insertSpaces": false,
  "editor.unicodeHighlight.nonBasicASCII": false,
  "editor.largeFileOptimizations": false,

  // The style does not live here but in files Prettier's CLI reads too: each project's .prettierrc
  // or, without one, ~/.prettierrc.json (40-format/prettierrc.json). So the editor, the terminal and
  // CI format alike. The editor's "prettier.*" settings would apply only with no config file, and
  // under ~ there is always one.
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "html.format.wrapLineLength": 130,
  "css.enabledLanguages": ["html"],
  // What Prettier does not format, with its native tool. shfmt without flags reads the project's
  // .editorconfig (indentation and `switch_case_indent`).
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  "[sql]": {
    "editor.defaultFormatter": "mtxr.sqltools"
  },

  // Saves on a tab or window change, not on a timer: format on save does not run for delayed
  // autosaves ("afterDelay"), so with it files were almost never formatted.
  "files.autoSave": "onFocusChange",
  "files.eol": "\n",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "symbols.hidesExplorerArrows": false,

  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.fontFamily": "'CaskaydiaCove Nerd Font'",
  "terminal.integrated.initialHint": false,

  "git.enableSmartCommit": true,
  "git.autofetch": true,

  "auto-close-tag.enableAutoCloseTag": true,
  "auto-rename-tag.activationOnLanguage": ["html", "xml", "php", "javascript"],
  "sqltools.highlightQuery": false,
  "sqltools.results.limit": 100,
  "js/ts.updateImportsOnFileMove.enabled": "always",

  // Workspace trust on (the default) and asking: lab material or downloaded repos open in
  // restricted mode (no tasks or extensions that run code) until you confirm them.
  "security.workspace.trust.enabled": true,
  "telemetry.telemetryLevel": "off"
}
