# Every keyboard shortcut of the desktop. sxhkd runs in the background, started by bspwm, and turns
# each key combination into its command.
# Reload without restarting the session: Super+Escape.

# kitty from apt rather than a manual install in /opt, so unattended-upgrades patches it with the
# rest of the system. The absolute path keeps a same-named binary earlier in $PATH from running.
super + Return
	/usr/bin/kitty

# Applications with their name and icon; Ctrl+Tab switches to any executable in $PATH, for terminal
# tools with no menu entry.
super + d
	/usr/bin/rofi -show drun -modes drun,run

# Nautilus in the home folder, like Win+E on Windows; --new-window opens one even if another
# workspace already has one. A click on the Parrot logo in polybar opens it too.
super + e
	/usr/bin/nautilus --new-window

# USR1 makes the daemon read this file again: a new binding without logging out. A signal to
# sxhkd itself, not a way to stop it.
super + Escape
	pkill -USR1 -x sxhkd

# Super+Alt+Q quits bspwm (and the X session); Super+Alt+R restarts it in place, reading bspwmrc
# again without losing windows. Alt and not Shift: Super+Shift+Q already kills the focused window,
# and sharing it made it unclear whether a window or the session would close.
super + alt + {q,r}
	bspc {quit,wm -r}

# Super+Q asks the focused window to close (WM_DELETE); Super+Shift+Q kills it, for an app that
# does not respond.
super + {_,shift + }q
	bspc node -{c,k}

# Monocle shows one window full screen and hides the others, without closing them.
super + m
	bspc desktop -l next

# Moves the marked window (Super+Ctrl+M) to the preselected spot (Super+Ctrl+Alt+arrow).
super + y
	bspc node newest.marked.local -n newest.!automatic.local

# Swaps the current window with the biggest one of the workspace.
super + g
	bspc node -s biggest.window

# Window state: tiled, pseudo-tiled (centered, keeps the gaps), floating (free, dragged with the
# mouse) and fullscreen.
super + {t,shift + t,s,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# Node flags: marked (for Super+Y), locked (Super+Q cannot close it by accident), sticky (stays on
# every workspace) and private (keeps its size when other windows appear).
super + ctrl + {m,x,y,z}
	bspc node -g {marked,locked,sticky,private}

# Arrows move the focus; with Shift they swap the focused window with its neighbor.
super + {_,shift + }{Left,Down,Up,Right}
	bspc node -{f,s} {west,south,north,east}

# bspwm keeps the windows in a binary tree: these jump to the parent, the sibling or a child.
super + {p,b,comma,period}
	bspc node -f @{parent,brother,first,second}

super + {_,shift + }c
	bspc node -f {next,prev}.local.!hidden.window

# Previous and next desktop of the same monitor; [ and ] sit next to P, handier than numbers.
super + bracket{left,right}
	bspc desktop -f {prev,next}.local

# Super+` goes back to the previous window, Super+Tab to the previous desktop.
super + {grave,Tab}
	bspc {node,desktop} -f last

# Walks the focus history. Recording stops for the jump (-h off) so the jump itself is not saved.
super + {o,i}
	bspc wm -h off; \
	bspc node {older,newer} -f; \
	bspc wm -h on

# Super+N goes to desktop N and Super+Shift+N sends the window there; 0 is desktop 10.
super + {_,shift + }{1-9,0}
	bspc {desktop -f,node -d} '^{1-9,10}'

# Preselection keeps a spot for the next window that opens: the side of the node.
super + ctrl + alt + {Left,Down,Up,Right}
	bspc node -p {west,south,north,east}

# The share of the node the new window takes, 0.1 to 0.9.
super + ctrl + {1-9}
	bspc node -o 0.{1-9}

# Cancels the preselection of the focused node.
super + ctrl + alt + space
	bspc node -p cancel

# Cancels every preselection of the current desktop.
super + ctrl + shift + space
	bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

# Moves a floating window 20 px. Ctrl because Super+Shift+arrows already swaps tiled windows: with
# the same combination in two bindings, sxhkd ran only one.
super + ctrl + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}

# The script grows or shrinks the window by the nearest edge in that direction, so there is no
# expand or contract to think about.
super + alt + {Left,Down,Up,Right}
	~/.config/bspwm/scripts/bspwm_resize {west,south,north,east}

# Firefox with separate profiles. Personal (mail, personal GitHub): the default-esr profile,
# unchanged. Pentest (engagements, targets, labs): the pentest profile with a hardened user.js (no
# target leaks to third parties, no preloading, no WebRTC, everything cleared on close; see
# 70-system/firefox/pentest.user.js and docs/firefox.md).
# TZ=UTC is a fallback: privacy.resistFingerprinting, which Parrot turns on system-wide, already
# hides the time zone, and TZ=UTC keeps hiding the local time if that protection goes off.
# --no-remote lets both profiles be open at once; without it Firefox opens a tab in the running
# instance instead of starting the other profile.
super + shift + f
	/usr/bin/firefox -P default-esr --no-remote

super + shift + p
	TZ=UTC /usr/bin/firefox -P pentest --no-remote

# Locks with LightDM's login screen (slick-greeter): the same look as at boot, no extra packages
# and instant (no screenshot, no blur). The session manager checks the password, and the session
# comes back as it was.
super + shift + x
	/usr/bin/dm-tool lock

# Turns onion routing on or off, with a notification and the polybar indicator; the same as a left
# click on polybar's anonymity module.
super + a
	~/.config/scripts/toggle_anonymity.sh
