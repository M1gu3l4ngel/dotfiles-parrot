// Makes Caps Lock turn off on press, as on Windows and macOS. keymap.xkb includes it as
// `capsfix(press)` and bspwmrc loads it with xkbcomp at login. Reload: Super+Alt+R.
//
// XKB's standard Caps Lock uses LockMods, which unlocks the capitals on release: typing fast (Caps,
// S, Caps, i) presses the "i" before Caps is released, and "SI" comes out instead of "Si".
//
// Here the key has two levels (ALPHABETIC type): with Caps off it uses level 1 (the usual lock);
// with Caps on, level 2, whose action applies Shift+Lock on press. Shift + Lock cancels the capitals
// at once, and `affect=unlock` makes it only unlock, never lock. `repeat = No` keeps a held key from
// toggling out of control.

default partial modifier_keys
xkb_symbols "press" {
  replace key <CAPS> {
    repeat = No,
    type[Group1] = "ALPHABETIC",
    symbols[Group1] = [ Caps_Lock, Caps_Lock ],
    actions[Group1] = [ LockMods(modifiers = Lock),
                        LockMods(modifiers = Shift + Lock, affect = unlock) ]
  };
  modifier_map Lock { <CAPS> };
};
