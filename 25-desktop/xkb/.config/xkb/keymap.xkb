// The session's whole keymap: us and latam layouts, switched with Alt+Shift, and the Caps Lock fix
// (symbols/capsfix). It replaces `setxkbmap`, which takes only system options and cannot include
// the custom capsfix symbol. bspwmrc loads it with
// xkbcomp -I"$HOME/.config/xkb" keymap.xkb "$DISPLAY". Reload: Super+Alt+R.
//
// To add a layout, put it in xkb_symbols with its group number (`+es:3`). `pc105` is the standard
// physical keyboard with the extra key next to the left Shift (ISO).

xkb_keymap {
  xkb_keycodes { include "evdev+aliases(qwerty)" };
  xkb_types    { include "complete" };
  xkb_compat   { include "complete" };
  xkb_symbols  { include "pc+us+latam:2+inet(evdev)+group(alt_shift_toggle)+capsfix(press)" };
  xkb_geometry { include "pc(pc105)" };
};
