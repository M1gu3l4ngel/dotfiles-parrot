#!/bin/sh
# Resizes the focused window in one direction; sxhkd runs it with Super+Alt+arrows
# (bspwm_resize west|east|north|south).
#
# One key per direction grows or shrinks the window depending on where it is: it first tries to
# move the right (or top) edge, and if that side cannot move, the opposite one. So there is no
# expand or contract to think about.

set -eu

# Fine steps for floating windows, big ones in tiling, where the size is shared with the neighbors.
if bspc query -N -n focused.floating >/dev/null; then
  step=20
else
  step=100
fi

case "${1:-}" in
  west)
    dir=right falldir=left x="-$step" y=0
    ;;
  east)
    dir=right falldir=left x="$step" y=0
    ;;
  north)
    dir=top falldir=bottom x=0 y="-$step"
    ;;
  south)
    dir=top falldir=bottom x=0 y="$step"
    ;;
  *)
    echo "Usage: $0 west|east|north|south" >&2
    exit 2
    ;;
esac

bspc node -z "$dir" "$x" "$y" || bspc node -z "$falldir" "$x" "$y"
