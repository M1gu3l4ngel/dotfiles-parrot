#! /bin/sh
# bspwm's startup script: it runs when bspwm starts the session, and again in full on every restart.
# Reload: Super+Alt+R (sxhkdrc).

# The script runs again on every Super+Alt+R: run_once starts a daemon only if it is not running,
# or each reload would try a second instance (which fails, or worse, stays duplicated).
run_once() {
  pgrep -x "$1" >/dev/null || "$@" &
}

run_once sxhkd
# The session keymap: us and latam layouts swapped with Alt+Shift, and Caps Lock fixed to turn off
# on press rather than on release (with X11's standard behavior, typing "Caps S Caps i" fast gives
# "SI"). xkbcomp and not setxkbmap, which cannot include custom symbols such as capsfix. In the
# foreground (no &) so the keymap is ready before the rest of the session.
xkbcomp -w 0 -I"$HOME/.config/xkb" "$HOME/.config/xkb/keymap.xkb" "$DISPLAY"
# Key repeat starts at 300 ms and repeats 40 times a second: X11's default (660 ms, 25 a second)
# makes holding Backspace or the arrows feel slow.
xset r rate 300 40
# Old tools ring X11's bell for things that are not errors, and in a VM the beep sounds like a
# system failure.
xset b off

bspc monitor -d I II III IV V VI VII VIII IX X

# A 1 px border shows which window has the focus without typing in it. Neutral greys: the focus is
# clear without competing with the content, and orange stays for accents. Neutral and not the
# palette's warm grey, which looks yellowish in a thin frame. The unfocused windows (normal, and
# active: the last focused one on another monitor) almost blend with the background.
bspc config border_width 1
bspc config focused_border_color '#555555'
bspc config normal_border_color '#242424'
bspc config active_border_color '#242424'
# 12 px, the same spacing as the polybar bars: windows and bars sit on one grid.
bspc config window_gap 12

bspc config split_ratio 0.52
# Monocle shows one window: no border or gaps, to use the whole screen.
bspc config borderless_monocle true
bspc config gapless_monocle true

bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off

# VMware integration (clipboard, automatic resolution), only where open-vm-tools is installed: on
# real hardware the command does not exist. No run_once: vmware-user never opens a second instance.
command -v vmware-user >/dev/null && vmware-user &
# install.sh links ~/.config/wallpaper.jpg to the repo's assets/wallpaper.jpg the first time; for
# your own wallpaper, replace that file or change this path. A missing wallpaper must not break the
# session start.
/bin/feh --bg-fill ~/.config/wallpaper.jpg 2>/dev/null || true
# Its config changes apply with `dunstctl reload`, not a restart.
run_once dunst
# No run_once on purpose: launch.sh closes the old bars and starts them again, so Super+Alt+R
# reloads polybar too.
~/.config/polybar/launch.sh &
# picom reads picom.conf again whenever it is saved; it never needs a restart.
run_once picom
