/*
 * The launcher theme with kitty and polybar's Monokai Soda palette: the same surface, 1 px frame
 * and 8 px radius as the bars. config.rasi loads it with `@theme`; it applies the next time rofi
 * opens. Spacing scale 4/8/12: 12 px inner margin, 8 px between items.
 */

// The same values as ~/.config/scripts/palette.sh.
* {
    font:   "CaskaydiaCove Nerd Font 12";

    surface:    #1A1A1A;
    surface-hi: #242424;
    frame:      #555555;
    fg:         #C4C5B5;
    muted:      #8F8B7A;
    accent:     #FA8419;
    alert:      #F4005F;

    background-color:   transparent;
    text-color:         @fg;

    margin:     0;
    padding:    0;
    spacing:    0;
}

// transparency "real" leaves the corners outside the radius transparent (picom composes them);
// picom leaves rofi out of its own rounding so this radius holds.
window {
    transparency:   "real";
    location:       center;
    width:          560px;

    background-color:   @surface;
    border:             1px;
    border-color:       @frame;
    border-radius:      8px;
}

mainbox {
    padding:    12px;
    spacing:    8px;
}

inputbar {
    padding:    8px 12px;
    spacing:    8px;
    children:   [ prompt, entry ];

    background-color:   @surface-hi;
    border-radius:      4px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder:        "Buscar";
    placeholder-color:  @muted;
    cursor:             text;
}

prompt, entry, element-icon, element-text {
    vertical-align: 0.5;
}

// rofi's error and warning messages.
textbox {
    padding:            8px 12px;
    background-color:   @surface-hi;
    border-radius:      4px;
}

listview {
    lines:          8;
    columns:        1;
    spacing:        4px;
    fixed-height:   false;
    scrollbar:      false;
}

element {
    padding:        8px 12px;
    spacing:        12px;
    border-radius:  4px;
}

element normal urgent {
    text-color: @alert;
}

element normal active, element alternate active {
    text-color: @accent;
}

// Selected: a slightly lighter surface and the focus color for the text, the same convention as
// polybar's active workspace.
element selected normal, element selected active {
    background-color:   @surface-hi;
    text-color:         @accent;
}

element selected urgent {
    background-color:   @alert;
    text-color:         @surface;
}

// 24 px: the icon is recognized at a glance without making each row taller.
element-icon {
    size:   24px;
}

element-text {
    text-color: inherit;
}
