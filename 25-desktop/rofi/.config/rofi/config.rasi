/*
 * rofi's global configuration: the theme for every mode (run, drun, window). The themes live in
 * ~/.config/rofi/themes/; to switch, change the @theme line. To try one without touching this file:
 *   rofi -show run -theme ~/.config/rofi/themes/<name>.rasi
 */

// Each application shows the icon of the system's theme (GTK): the app is recognized before its
// name is read.
configuration {
    show-icons:     true;
    icon-theme:     "Flat-Remix-Green-Dark";
}

// Relative to the config folder (~/.config/rofi/), so it works with any $HOME.
@theme "themes/monokai-soda"
