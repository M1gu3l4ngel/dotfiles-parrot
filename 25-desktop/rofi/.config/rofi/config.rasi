/*
 * rofi's global configuration: the theme for every mode (run, drun, window). Ours is
 * themes/monokai-soda.rasi; rofi's own live in /usr/share/rofi/themes/ and load by name. To switch,
 * change the @theme line. To try one without touching this file:
 *   rofi -show drun -theme <name>
 */

// Each application shows the icon of the system's theme (GTK): the app is recognized before its
// name is read.
configuration {
    show-icons:     true;
    icon-theme:     "Flat-Remix-Green-Dark";
}

// Relative to the config folder (~/.config/rofi/), so it works with any $HOME.
@theme "themes/monokai-soda"
