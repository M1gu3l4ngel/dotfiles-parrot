# Desktop notifications with kitty and polybar's Monokai Soda palette: #1A1A1A background, cream
# text, a subtle grey border and red only for critical ones. bspwmrc starts dunst at login.
# Reload after editing: `dunstctl reload`. Try the look: notify-send -u low|normal|critical "Title"
# "Text"
#
# - Bottom right: polybar takes the whole top edge, and down here the toasts cover no bar.
# - The same background for every urgency, only the border changes: red is kept for errors
#   (critical), so it stands out as the exception.
# - No image icons: the scripts put a Nerd Font glyph in the title.

[global]
    monitor = 0
    follow = none
    width = 320
    height = (0, 300)
    origin = bottom-right
    offset = (15, 15)
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 4

    icon_corner_radius = 0

    indicate_hidden = yes
    transparency = 0
    separator_height = 0
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 0
    frame_width = 2
    frame_color = "#2a2a2a"
    gap_size = 10
    separator_color = frame

    sort = yes

    font = CaskaydiaCove Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    icon_position = off
    min_icon_size = 0
    max_icon_size = 0

    sticky_history = yes
    history_length = 20

    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open

    title = Dunst
    class = Dunst

    # 8 px, like the polybar bars: a notification is a small piece, one step below the windows'
    # radius (10 in picom).
    corner_radius = 8
    ignore_dbusclose = false

    force_xwayland = false
    force_xinerama = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

# highlight is the progress bar color: amber, polybar's accent.

[urgency_low]
    background = "#1A1A1A"
    foreground = "#888888"
    frame_color = "#2A2A2A"
    highlight = "#FEC006"
    timeout = 4

[urgency_normal]
    background = "#1A1A1A"
    foreground = "#C4C5B5"
    frame_color = "#3A3A3A"
    highlight = "#FEC006"
    timeout = 5
    override_pause_level = 30

# Critical: Monokai red border and longer on screen, so an error is not missed (0 would be forever
# and force closing them by hand).
[urgency_critical]
    background = "#1A1A1A"
    foreground = "#C4C5B5"
    frame_color = "#F4005F"
    highlight = "#F4005F"
    timeout = 8
    override_pause_level = 60
