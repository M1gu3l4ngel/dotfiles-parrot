# Default style for projects that do not bring their own .editorconfig, linked as ~/.editorconfig.
# Editors look for it walking up from the open file, so it reaches everything under ~
# (~/Dev/projects, ~/Dev/scratch). A project with its own .editorconfig and `root = true` stops
# the search: this one never overrides a project's.
#
# Same values as format/prettierrc.json (~/.prettierrc.json): this file covers what Prettier does
# not format (shell, SQL, TOML, .env...) and the indentation the editor inserts while typing. It
# applies when the file is opened; VSCodium needs the EditorConfig.EditorConfig extension.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2

# Two trailing spaces in Markdown are a forced line break.
[*.md]
trim_trailing_whitespace = false

# The YAML spec forbids tabs for indentation.
[*.{yml,yaml}]
indent_style = space
