# .shellcheckrc
# Permite a shellcheck seguir los archivos que cargan los scripts con `.`
# (p. ej. 25-desktop/scripts/.config/scripts/palette.sh), buscándolos junto al script.
# Sin esto, avisaría de variables "no definidas" que sí vienen del archivo cargado.
source-path=SCRIPTDIR
external-sources=true
