# The repo's formatting conventions. Most editors read it on their own (VSCodium with the
# EditorConfig extension, Neovim, JetBrains), so anyone who clones the repo writes in the same
# style without configuring the editor. https://editorconfig.org

# Stops the search here: the global ~/.editorconfig never applies inside the repo.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
# shfmt's own key for indented `case` (the same as -ci). shfmt reads .editorconfig only when it
# runs without flags, as VSCodium's extension does; without it the editor would format differently
# from tools/check.sh. It goes in [*] because scripts with no extension (bspwmrc) have no pattern.
switch_case_indent = true

# Two trailing spaces in Markdown are a line break and must stay; nested lists take 4 spaces.
[*.md]
indent_size = 4
trim_trailing_whitespace = false

# Byte for byte the same as in dotfiles-windows, which indents it with tabs.
[10-shell/oh-my-posh/*.json]
indent_style = tab

# sxhkd's own convention: the command under each binding is indented with a tab.
[sxhkdrc]
indent_style = tab

# make requires literal tabs; spaces fail with "missing separator".
[Makefile]
indent_style = tab
