#! /bin/sh
# ~/.config/bspwm/bspwmrc
# Archivo principal de configuración de bspwm (tiling window manager).
# Se ejecuta automáticamente cuando bspwm arranca la sesión.
# Para recargar en caliente: Super+Alt+R (definido en sxhkdrc).

# ----- DAEMONS Y TECLADO -----
# bspwmrc se vuelve a ejecutar entero en cada Super+Alt+R. run_once lanza un
# daemon solo si no está corriendo ya; sin esto cada recarga intentaría abrir
# una segunda instancia (que falla con error o, peor, queda duplicada).
run_once() {
  pgrep -x "$1" > /dev/null || "$@" &
}

# sxhkd es el daemon que escucha atajos de teclado; sin él no funciona ningún
# binding (Super+Enter, Super+D, etc).
run_once sxhkd
# Keymap de la sesión (~/.config/xkb/keymap.xkb): layouts us + latam
# intercambiables con Alt+Shift, y Caps Lock corregido para que se apague al
# pulsar y no al soltar (con el comportamiento estándar de X11, escribir rápido
# "Caps S Caps i" produce "SI"). Se usa xkbcomp y no setxkbmap porque
# setxkbmap no puede incluir símbolos propios como capsfix.
# Se ejecuta en primer plano (sin &) para que el keymap esté listo antes que
# el resto de la sesión.
xkbcomp -w 0 -I"$HOME/.config/xkb" "$HOME/.config/xkb/keymap.xkb" "$DISPLAY"
# Autorepetición al mantener una tecla: empieza a los 300 ms y repite 40 veces
# por segundo. El default de X11 (660 ms / 25 por segundo) hace que mantener
# Backspace o las flechas se sienta lento.
xset r rate 300 40
# Desactiva el timbre de X11. Herramientas antiguas lo disparan sin que sea un
# error real (p. ej. `import` de ImageMagick, que i3lock-fancy usa para la
# captura del lock), y en una VM el beep suena como un fallo del sistema.
xset b off

# ----- WORKSPACES -----
# Diez escritorios virtuales numerados en romanos (I..X), uno por monitor
# por defecto. Se cambia entre ellos con Super+<número> desde sxhkd.
bspc monitor -d I II III IV V VI VII VIII IX X

# ----- BORDES Y GAPS -----
# Borde inicial de 2px: bspwm lo necesita > 0 para calcular ciertos layouts.
# Al final del archivo lo bajamos a 0 para que no se vea en pantalla.
bspc config border_width         2
# Separación entre ventanas en píxeles. Mientras más alto, más "aire" entre
# las ventanas (estética tipo rice).
bspc config window_gap          12

# ----- LAYOUT -----
# Proporción inicial al hacer split: 52% para la ventana principal.
bspc config split_ratio          0.52
# En modo monocle (una sola ventana visible) no se dibujan bordes ni gaps,
# para aprovechar toda la pantalla.
bspc config borderless_monocle   true
bspc config gapless_monocle      true

# ----- REGLAS DE VENTANAS -----
# Cada regla dice "cuando aparezca una ventana de esta app, hazle esto".
# Útil para forzar workspace, modo floating, foco, etc.
bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off

# ----- AUTOSTART -----
# Integración con VMware (portapapeles, resolución automática). Solo si
# open-vm-tools está instalado: en un host real el comando no existe. No
# necesita run_once: el propio vmware-user no abre una segunda instancia.
command -v vmware-user >/dev/null && vmware-user &
# Wallpaper de fondo. install.sh enlaza ~/.config/wallpaper.jpg al wallpaper
# por defecto del repo (assets/wallpaper.jpg) la primera vez. Para usar tu
# propio fondo: sobrescribe ese archivo o cambia esta ruta.
# El `|| true` evita que un wallpaper faltante rompa el inicio de bspwm.
/bin/feh --bg-fill ~/.config/wallpaper.jpg 2>/dev/null || true
# Notificaciones de escritorio. Sus cambios de config se aplican con
# `dunstctl reload`, no reiniciándolo.
run_once dunst
# Barra de estado (polybar). Sin run_once a propósito: launch.sh ya mata las
# barras viejas y las relanza, así Super+Alt+R también recarga polybar.
~/.config/polybar/launch.sh &
# Compositor: sombras, transparencias y blur. Sin él las ventanas se ven
# planas. Relee picom.conf solo al guardarlo, no hace falta reiniciarlo.
run_once picom

# ----- FIN: OCULTAR BORDE -----
# Después de que todo esté inicializado, ponemos el borde a 0 para que no
# se vea ninguna línea alrededor de las ventanas. Se hace al final (y no
# desde el inicio) porque bspwm necesita un border_width > 0 al cargar las
# reglas para calcular bien ciertos layouts; después se baja a 0 puramente
# por estética.
bspc config border_width 0
