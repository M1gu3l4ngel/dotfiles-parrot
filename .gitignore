# === Backups creados durante migración ===
*.bak
*.pre-dotfiles.bak

# === Editor temp files ===
*.swp
*.swo
*~

# === OS junk ===
.DS_Store
Thumbs.db
desktop.ini

# === Asistentes de IA / agentes ===
# Se versionan las instrucciones del proyecto para Claude Code: CLAUDE.md y
# .claude/rules/. Se ignoran solo las partes personales de cada usuario, como
# indica la documentación oficial de Claude Code.
CLAUDE.local.md
.claude/settings.local.json
.cursor/
.aider*
.windsurfrules

# === Log files ===
*.log

# === Cache de aplicaciones ===
.cache/
*.cache

# === Datos sensibles (NUNCA commitear) ===
.env
.env.*
*.key
*.pem
*_rsa
*_dsa
*_ed25519
secrets/
.config/bin/target

# === Fuentes ===
# No se versionan binarios de fuentes: bootstrap.sh las descarga en versión
# fijada y verificada por SHA-256 (evita inflar el repo y problemas de licencia).
*.ttf
*.otf

# === Lock files que crean ruido (excepto los importantes) ===
# Nvim: SÍ versionamos lazy-lock.json (versiones reproducibles)
# Polybar/picom: nada que ignorar

# === Logs generados por scripts ===
*.tmp

