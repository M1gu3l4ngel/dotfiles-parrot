# Backups that install.sh leaves next to what it replaces.
*.bak
*.pre-dotfiles.bak

# Editor temporary files.
*.swp
*.swo
*~

# Operating system leftovers.
.DS_Store
Thumbs.db
desktop.ini

# AI assistants: the project's Claude Code instructions (CLAUDE.md and .claude/rules/) are
# versioned; only each user's personal parts are ignored, as Claude Code's documentation says.
CLAUDE.local.md
.claude/settings.local.json
.cursor/
.aider*
.windsurfrules

*.log
*.tmp

.cache/
*.cache

# Secrets and keys: never committed, the repo is public.
.env
.env.*
*.key
*.pem
*_rsa
*_dsa
*_ed25519
secrets/

# No font binaries: bootstrap.sh downloads them at a pinned version checked by SHA-256, which keeps
# the repo small and clear of license problems.
*.ttf
*.otf
