# Linked as ~/.gitconfig by install.sh. The identity (`user.name`, `user.email`) belongs to each
# person and the signing key (`user.signingkey`) to each machine: both go in ~/.gitconfig.local,
# which bootstrap.sh fills from --git-name and --git-email. A fork never commits under the owner's
# name.
[init]
	defaultBranch = main
[commit]
	gpgsign = true
[tag]
	gpgsign = true
# What does not belong in a public repo (the signing key, any organization or work account)
# lives in this machine-local file, outside the repo. If it does not exist, git ignores it.
[include]
	path = ~/.gitconfig.local
